# Run from the repository root with lmctl test.lms or lmscript test.lms.
compiler = env("LMSCRIPT_BIN");
if (compiler != "") { set_env("LMSCRIPT_BIN", compiler); set_env("LMSCRIPT_STD_BIN", compiler); }
compiler_module = env("LMCODE_COMPILER_MODULE");
if (compiler_module != "") { set_env("LMCODE_COMPILER_MODULE", compiler_module); }
fn step(command) {
  result = system(command, {timeoutMs:0});
  print(result.stdout); print(result.stderr);
  assert(result.code == 0, "failed: " + json_stringify(command));
}
step(["bash", "scripts/compile-example.sh"]);
step(["bash", "scripts/sync-rest.sh", "--verify"]);
step(["cargo", "test", "--workspace", "--locked"]);
step(["cargo", "test", "-p", "dslvm", "--locked", "rest"]);
step(["cargo", "build", "--workspace", "--release", "--locked"]);
step(["cargo", "run", "--release", "--bin", "dsl-conformance", "--", "conformance/vectors"]);
step(["cargo", "run", "--release", "--bin", "dsl-conformance", "--", "conformance/stdlib-vectors"]);
step(["python3", "scripts/test-invocation-vectors.py"]);
step(["python3", "scripts/test-dry-controls.py"]);
step(["python3", "scripts/mutate-results.py"]);
step(["cargo", "run", "--release", "--bin", "rule-entries", "--", "target/rule-entries.dslb"]);
