* text=auto eol=lf
# Precompiled vectors bind to the exact schema bytes, including line endings.
conformance/vectors/*.json text eol=lf
conformance/stdlib-vectors/*.json text eol=lf
*.dslb binary
vectors.lock text eol=lf
stdlib-vectors.lock text eol=lf
conformance/vectors/*.expect text eol=lf
conformance/vectors/*.dsl text eol=lf
conformance/stdlib-vectors/*.expect text eol=lf
conformance/stdlib-vectors/*.dsl text eol=lf
stdlib/*.json text eol=lf
std/*.json text eol=lf
std.lock text eol=lf
dslvm/tests/fixtures/*.json text eol=lf
conformance/stdlib-vectors/*.md text eol=lf
# REST conformance fixtures and their lock: keep bytes exact on every OS (the bytecode binds to the schema bytes).
conformance/rest-suite/* text eol=lf
conformance/rest-suite/*.dslb binary
rest-suite.lock text eol=lf
scripts/sync-rest.sh text eol=lf
