# Canonical router lmcode body. test.sh compiles this block with the mono compiler API.
router = _lmcode_ schema="../schema/router.dsl.json";
# Version 1 of the router: only GET is served and it returns the current date.
if (req.method() == "GET") {
  res.status(200);
  res.body(now_date());
} else {
  res.status(405);
  res.body("method not allowed");
}
end _lmcode_
router;
